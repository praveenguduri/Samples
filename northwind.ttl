    rdfs:subPropertyOf ex:hasId .

ex:supplierCompanyName a owl:DatatypeProperty ;
    rdfs:label "supplierCompanyName" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasName .

ex:supplierContactName a owl:DatatypeProperty ;
    rdfs:label "supplierContactName" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierContactTitle a owl:DatatypeProperty ;
    rdfs:label "supplierContactTitle" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierAddress a owl:DatatypeProperty ;
    rdfs:label "supplierAddress" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierCity a owl:DatatypeProperty ;
    rdfs:label "supplierCity" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierRegion a owl:DatatypeProperty ;
    rdfs:label "supplierRegion" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierPostalCode a owl:DatatypeProperty ;
    rdfs:label "supplierPostalCode" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string .

ex:supplierCountry a owl:DatatypeProperty ;
    rdfs:label "supplierCountry" ;
    rdfs:domain ex:Supplier ;

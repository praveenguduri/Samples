ex:employeeHomePhone a owl:DatatypeProperty ;
    rdfs:label "employeeHomePhone" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasPhone .

ex:employeeAddress a owl:DatatypeProperty ;
    rdfs:label "employeeAddress" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeCity a owl:DatatypeProperty ;
    rdfs:label "employeeCity" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeRegion a owl:DatatypeProperty ;
    rdfs:label "employeeRegion" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeePostalCode a owl:DatatypeProperty ;
    rdfs:label "employeePostalCode" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeCountry a owl:DatatypeProperty ;
    rdfs:label "employeeCountry" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeExtension a owl:DatatypeProperty ;
    rdfs:label "employeeExtension" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

#################################################################

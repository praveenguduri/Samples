ex:employeeTitle a owl:DatatypeProperty ;
    rdfs:label "employeeTitle" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeTitleOfCourtesy a owl:DatatypeProperty ;
    rdfs:label "employeeTitleOfCourtesy" ;
    rdfs:domain ex:Employee ;

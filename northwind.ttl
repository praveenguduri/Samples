ex:supplierFax a owl:DatatypeProperty ;
    rdfs:label "supplierFax" ;
    rdfs:domain ex:Supplier ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasFax .

#################################################################
# Shipper datatype properties
#################################################################

ex:shipperId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "shipperId" ;
    rdfs:domain ex:Shipper ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf ex:hasId .

ex:shipperCompanyName a owl:DatatypeProperty ;
    rdfs:label "shipperCompanyName" ;
    rdfs:domain ex:Shipper ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasName .

ex:shipperPhone a owl:DatatypeProperty ;
    rdfs:label "shipperPhone" ;
    rdfs:domain ex:Shipper ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasPhone .

#################################################################
# Region & Territory datatype properties
#################################################################

ex:regionId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "regionId" ;
    rdfs:domain ex:Region ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf ex:hasId .

ex:territoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "territoryId" ;
    rdfs:domain ex:Territory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasId .

ex:territoryDescription a owl:DatatypeProperty ;
    rdfs:label "territoryDescription" ;
    rdfs:domain ex:Territory ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasDescription .

#################################################################
# Generic object properties
#################################################################

ex:relatedTo a owl:ObjectProperty ;
    rdfs:label "relatedTo" ;
    rdfs:comment "Very generic relationship between Things." .

ex:hasAddress a owl:ObjectProperty ;
    rdfs:label "hasAddress" ;
    rdfs:domain ex:Party ;
    rdfs:range ex:Address ;
    rdfs:subPropertyOf ex:relatedTo .

ex:hasContactInfo a owl:ObjectProperty ;
    rdfs:label "hasContactInfo" ;
    rdfs:domain ex:Party ;
    rdfs:range ex:ContactInfo ;
    rdfs:subPropertyOf ex:relatedTo .

#################################################################
# Order-related object properties
#################################################################

ex:orderCustomer a owl:ObjectProperty ;
    rdfs:label "orderCustomer" ;
    rdfs:domain ex:Order ;
    rdfs:range ex:Customer ;
    rdfs:subPropertyOf ex:relatedTo .

ex:customerOrder a owl:ObjectProperty ;
    rdfs:label "customerOrder" ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:Order ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:orderCustomer .

ex:orderEmployee a owl:ObjectProperty ;
    rdfs:label "orderEmployee" ;
    rdfs:domain ex:Order ;
    rdfs:range ex:Employee ;
    rdfs:subPropertyOf ex:relatedTo .

ex:employeeOrder a owl:ObjectProperty ;
    rdfs:label "employeeOrder" ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Order ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:orderEmployee .

ex:orderShipper a owl:ObjectProperty ;
    rdfs:label "orderShipper" ;
    rdfs:domain ex:Order ;
    rdfs:range ex:Shipper ;
    rdfs:subPropertyOf ex:relatedTo .

ex:shipperOrder a owl:ObjectProperty ;
    rdfs:label "shipperOrder" ;
    rdfs:domain ex:Shipper ;
    rdfs:range ex:Order ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:orderShipper .

# Order ↔ OrderDetail

ex:orderHasDetail a owl:ObjectProperty ;
    rdfs:label "orderHasDetail" ;
    rdfs:domain ex:Order ;
    rdfs:range ex:OrderDetail ;
    rdfs:subPropertyOf ex:relatedTo .

ex:detailOfOrder a owl:ObjectProperty ;
    rdfs:label "detailOfOrder" ;
    rdfs:domain ex:OrderDetail ;
    rdfs:range ex:Order ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:orderHasDetail .

#################################################################
# Product-related object properties
#################################################################

ex:detailProduct a owl:ObjectProperty ;
    rdfs:label "detailProduct" ;
    rdfs:domain ex:OrderDetail ;
    rdfs:range ex:Product ;
    rdfs:subPropertyOf ex:relatedTo .

ex:productCategory a owl:ObjectProperty ;
    rdfs:label "productCategory" ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Category ;
    rdfs:subPropertyOf ex:relatedTo .

ex:categoryProduct a owl:ObjectProperty ;
    rdfs:label "categoryProduct" ;
    rdfs:domain ex:Category ;
    rdfs:range ex:Product ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:productCategory .

ex:productSupplier a owl:ObjectProperty ;
    rdfs:label "productSupplier" ;
    rdfs:domain ex:Product ;
    rdfs:range ex:Supplier ;
    rdfs:subPropertyOf ex:relatedTo .

ex:supplierProduct a owl:ObjectProperty ;
    rdfs:label "supplierProduct" ;
    rdfs:domain ex:Supplier ;
    rdfs:range ex:Product ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:productSupplier .

#################################################################
# Employee hierarchy and territories
#################################################################

ex:reportsTo a owl:ObjectProperty ;
    rdfs:label "reportsTo" ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Employee ;
    rdfs:subPropertyOf ex:relatedTo .

ex:employeeTerritory a owl:ObjectProperty ;
    rdfs:label "employeeTerritory" ;
    rdfs:domain ex:Employee ;
    rdfs:range ex:Territory ;
    rdfs:subPropertyOf ex:relatedTo .

ex:territoryEmployee a owl:ObjectProperty ;
    rdfs:label "territoryEmployee" ;
    rdfs:domain ex:Territory ;
    rdfs:range ex:Employee ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:employeeTerritory .

ex:territoryRegion a owl:ObjectProperty ;
    rdfs:label "territoryRegion" ;
    rdfs:domain ex:Territory ;
    rdfs:range ex:Region ;
    rdfs:subPropertyOf ex:relatedTo .

ex:regionTerritory a owl:ObjectProperty ;
    rdfs:label "regionTerritory" ;
    rdfs:domain ex:Region ;
    rdfs:range ex:Territory ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:territoryRegion .

#################################################################
# Customer ↔ CustomerDemographic
#################################################################

ex:customerHasDemographic a owl:ObjectProperty ;
    rdfs:label "customerHasDemographic" ;
    rdfs:domain ex:Customer ;
    rdfs:range ex:CustomerDemographic ;
    rdfs:subPropertyOf ex:relatedTo .

ex:demographicCustomer a owl:ObjectProperty ;
    rdfs:label "demographicCustomer" ;
    rdfs:domain ex:CustomerDemographic ;
    rdfs:range ex:Customer ;
    rdfs:subPropertyOf ex:relatedTo ;
    owl:inverseOf ex:customerHasDemographic .

#################################################################

ex:employeeId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "employeeId" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf ex:hasId .

ex:employeeLastName a owl:DatatypeProperty ;
    rdfs:label "employeeLastName" ;
    rdfs:domain ex:Employee ;
    rdfs:range xsd:string .

ex:employeeFirstName a owl:DatatypeProperty ;
    rdfs:label "employeeFirstName" ;
    rdfs:domain ex:Employee ;

ex:categoryId a owl:DatatypeProperty , owl:FunctionalProperty ;
    rdfs:label "categoryId" ;
    rdfs:domain ex:Category ;
    rdfs:range xsd:int ;
    rdfs:subPropertyOf ex:hasId .

ex:categoryName a owl:DatatypeProperty ;
    rdfs:label "categoryName" ;
    rdfs:domain ex:Category ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasName .

ex:categoryDescription a owl:DatatypeProperty ;
    rdfs:label "categoryDescription" ;
    rdfs:domain ex:Category ;
    rdfs:range xsd:string ;
    rdfs:subPropertyOf ex:hasDescription .

